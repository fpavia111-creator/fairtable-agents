      "bin": {
        "fairtable-approve": "bin/fairtable-approve.js",
        "fairtable-license": "bin/fairtable-license.js",
        "fairtable-new-agent": "bin/fairtable-new-agent.js",
        "fairtable-verify-log": "bin/fairtable-verify-log.js"
      },
      "engines": {
        "node": ">=20"
      }
    }
  }
