{
  "name": "fairtable-discounts-promos",
  "version": "0.1.0",
  "mcpName": "io.github.fpavia111-creator/fairtable-discounts-promos",
  "description": "Fairtable Discounts Promos: checks every discount and promotion rung in the POS against your promotion list: promos used after they ended, unknown or open discounts, discounts over their cap, employee meals over the allowance and missing approvals. Never changes the POS.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fairtable-discounts-promos": "bin/fairtable-discounts-promos.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/fairtable-discounts-promos.js demo",
    "eval": "node bin/fairtable-discounts-promos.js eval"
  },
  "dependencies": {
    "fairtable-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/fairtable-agents.git",
    "directory": "packages/fairtable-discounts-promos"
  },
  "homepage": "https://github.com/fpavia111-creator/fairtable-agents/tree/main/packages/fairtable-discounts-promos#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/fairtable-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "restaurant",
    "restaurants",
    "food-service",
    "fairtable",
    "discounts",
    "promotions",
    "loss-prevention"
  ]
}
