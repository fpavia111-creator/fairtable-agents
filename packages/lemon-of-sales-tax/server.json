{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.fpavia111-creator/lemon-of-sales-tax",
  "title": "Lemon of Sales Tax",
  "description": "Lemon of Sales Tax: tax collected in the POS against the rates you set for each location and menu…",
  "version": "0.1.0",
  "repository": {
    "url": "https://github.com/fpavia111-creator/fairtable-agents",
    "source": "github",
    "subfolder": "packages/lemon-of-sales-tax"
  },
  "websiteUrl": "https://fair-agents.com/fairtable.html",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "lemon-of-sales-tax",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        },
        {
          "type": "named",
          "name": "--root",
          "description": "Folder holding the exports this agent may read and write (it cannot reach outside it)",
          "isRequired": true,
          "format": "filepath",
          "valueHint": "exports_folder"
        }
      ]
    }
  ]
}
