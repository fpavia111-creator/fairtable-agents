{
  "name": "lychee-of-stockouts",
  "version": "0.1.0",
  "mcpName": "io.github.fpavia111-creator/lychee-of-stockouts",
  "description": "Lychee of Stockouts: reads the 86 log against item sales: items that run out again and again, how long they stay off, what that likely cost in sales, items 86ed before the dinner rush and items never brought back. Never changes 86 status or orders.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "lychee-of-stockouts": "bin/lychee-of-stockouts.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/lychee-of-stockouts.js demo",
    "eval": "node bin/lychee-of-stockouts.js eval"
  },
  "dependencies": {
    "fairtable-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/fairtable-agents.git",
    "directory": "packages/lychee-of-stockouts"
  },
  "homepage": "https://github.com/fpavia111-creator/fairtable-agents/tree/main/packages/lychee-of-stockouts#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/fairtable-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "restaurant",
    "restaurants",
    "food-service",
    "fairtable",
    "stockouts",
    "86",
    "par-levels"
  ]
}
