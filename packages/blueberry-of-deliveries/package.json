{
  "name": "blueberry-of-deliveries",
  "version": "0.1.0",
  "description": "Blueberry of Deliveries: matches every invoice line with what the receiving log says arrived and with the credit memos, and lists shorts, rejected cases and substitutions still waiting for a credit. Writes a credit request draft. Never pays and never contacts the vendor.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "blueberry-of-deliveries": "bin/blueberry-of-deliveries.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/blueberry-of-deliveries.js demo",
    "eval": "node bin/blueberry-of-deliveries.js eval"
  },
  "dependencies": {
    "fairtable-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/fairtable-agents.git",
    "directory": "packages/blueberry-of-deliveries"
  },
  "homepage": "https://github.com/fpavia111-creator/fairtable-agents/tree/main/packages/blueberry-of-deliveries#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/fairtable-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "restaurant",
    "restaurants",
    "food-service",
    "fairtable",
    "receiving",
    "credit-memos",
    "invoice-matching"
  ]
}
