{
  "name": "fairtable-gift-cards",
  "version": "0.1.0",
  "mcpName": "io.github.fpavia111-creator/fairtable-gift-cards",
  "description": "Fairtable Gift Cards: the outstanding gift card liability from your POS gift card export, by location, with balances that do not add up, negative balances, dormant cards and cards bought at one location and spent at another. Never changes a card or recognises breakage.",
