{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.fpavia111-creator/cherry-of-counts",
  "title": "Cherry of Counts",
  "description": "Cherry of Counts: compares each item's inventory count with what the system expected, prices the…",
  "version": "0.1.0",
  "repository": {
    "url": "https://github.com/fpavia111-creator/fairtable-agents",
    "source": "github",
    "subfolder": "packages/cherry-of-counts"
  },
  "websiteUrl": "https://fair-agents.com/fairtable.html",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "cherry-of-counts",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        },
        {
          "type": "named",
          "name": "--root",
          "description": "Folder holding the exports this agent may read and write (it cannot reach outside it)",
          "isRequired": true,
          "format": "filepath",
          "valueHint": "exports_folder"
        }
      ]
    }
  ]
}
