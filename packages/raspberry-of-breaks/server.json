{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.fpavia111-creator/raspberry-of-breaks",
  "title": "Raspberry of Breaks",
  "description": "Raspberry of Breaks: meal breaks from your timecards under the break rules in your settings…",
  "version": "0.1.0",
  "repository": {
    "url": "https://github.com/fpavia111-creator/fairtable-agents",
    "source": "github",
    "subfolder": "packages/raspberry-of-breaks"
  },
  "websiteUrl": "https://fair-agents.com/fairtable.html",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "raspberry-of-breaks",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        },
        {
          "type": "named",
          "name": "--root",
          "description": "Folder holding the exports this agent may read and write (it cannot reach outside it)",
          "isRequired": true,
          "format": "filepath",
          "valueHint": "exports_folder"
        }
      ]
    }
  ]
}
