{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.fpavia111-creator/fairtable-no-shows",
  "title": "Mango of No Shows",
  "description": "Fairtable No-Shows: reservation no-shows from your OpenTable or Resy export: the no-show rate by…",
  "version": "0.1.0",
  "repository": {
    "url": "https://github.com/fpavia111-creator/fairtable-agents",
    "source": "github",
    "subfolder": "packages/fairtable-no-shows"
  },
  "websiteUrl": "https://fair-agents.com/fairtable.html",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "fairtable-no-shows",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        },
        {
          "type": "named",
          "name": "--root",
          "description": "Folder holding the exports this agent may read and write (it cannot reach outside it)",
          "isRequired": true,
          "format": "filepath",
          "valueHint": "exports_folder"
        }
      ]
    }
  ]
}
