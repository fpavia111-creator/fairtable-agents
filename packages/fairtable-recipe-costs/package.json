{
  "name": "fairtable-recipe-costs",
  "version": "0.1.0",
  "mcpName": "io.github.fpavia111-creator/fairtable-recipe-costs",
  "description": "Fairtable Recipe Costs: costs every recipe at your latest invoice prices (pack sizes, units and yields), shows each plate's food cost percent against your target and the price that would meet it, and which plates got dearer. Never changes menu prices in the POS.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fairtable-recipe-costs": "bin/fairtable-recipe-costs.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/fairtable-recipe-costs.js demo",
    "eval": "node bin/fairtable-recipe-costs.js eval"
  },
  "dependencies": {
    "fairtable-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/fairtable-agents.git",
    "directory": "packages/fairtable-recipe-costs"
  },
  "homepage": "https://github.com/fpavia111-creator/fairtable-agents/tree/main/packages/fairtable-recipe-costs#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/fairtable-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "restaurant",
    "restaurants",
    "food-service",
    "fairtable",
    "recipe-costing",
    "plate-cost",
    "menu-pricing"
  ]
}
