    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "melon-of-catering": "bin/melon-of-catering.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/melon-of-catering.js demo",
    "eval": "node bin/melon-of-catering.js eval"
