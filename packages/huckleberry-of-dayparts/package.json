    "./package.json": "./package.json"
  },
  "bin": {
    "huckleberry-of-dayparts": "bin/huckleberry-of-dayparts.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
