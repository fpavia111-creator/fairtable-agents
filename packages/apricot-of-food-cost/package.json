{
  "name": "apricot-of-food-cost",
  "version": "0.1.0",
  "mcpName": "io.github.fpavia111-creator/apricot-of-food-cost",
  "description": "Apricot of Food Cost: actual against theoretical food cost from your POS item sales, recipes, inventory counts and invoices. Shows which ingredients were used more than the recipes say, with the cost of the gap. Never changes the POS and never sends.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "apricot-of-food-cost": "bin/apricot-of-food-cost.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/apricot-of-food-cost.js demo",
    "eval": "node bin/apricot-of-food-cost.js eval"
  },
  "dependencies": {
    "fairtable-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/fairtable-agents.git",
    "directory": "packages/apricot-of-food-cost"
  },
  "homepage": "https://github.com/fpavia111-creator/fairtable-agents/tree/main/packages/apricot-of-food-cost#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/fairtable-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "restaurant",
    "restaurants",
    "food-service",
    "fairtable",
    "food-cost",
    "theoretical-food-cost",
    "inventory",
    "recipe-costing"
  ]
}
