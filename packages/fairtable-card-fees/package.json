{
  "name": "fairtable-card-fees",
  "version": "0.1.0",
  "mcpName": "io.github.fpavia111-creator/fairtable-card-fees",
  "description": "Fairtable Card Fees: reads monthly card processing statements: the effective rate per location and month, processor markup over your agreed rate, fees you never agreed to, monthly fees over their cap and downgrade surcharges. Never contacts the processor or changes the account.",
